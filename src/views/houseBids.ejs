<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>House Bids</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="container mt-5">

        <div class="row mb-4">
            <div class="col-sm-10 logo-text-container">
                <div><a href="/">
                        <img src="/images/logo.png" height="200" width="300"></a>
                </div>
                <div>
                    <h2 class="heading">Providing houses all over the world</h2>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-md-6">
                <% if (house.houseInfo.image) { %>
                    <img src="/images/<%= house.houseInfo.image %>" alt="House Image" />
                    <% } else { %>
                        <img src="/images/photonotfound.jpeg" alt="Image Not Found" />
                        <% } %>
            </div>

            <div class="col-md-6">
                <div class="property-description">
                    <div>

                        <h4 style="font-weight: bold;">
                            <%= house.houseInfo.address.country%>
                        </h4>
                        <h3 style="font-weight: bold;">
                            <%= house.houseInfo.address.street %>, <%= house.houseInfo.address.city%>
                        </h3>

                        <p class="house-price">$<%= house.houseInfo.askingPrice.toLocaleString() %>
                        </p>
                        <p>
                            <%= house.houseInfo.description%>
                        </p>
                    </div>
                </div>

                <table class="table">

                    <thead>
                        <tr>
                            <th></th>
                            <th>Bidder</th>
                            <th>Amount</th>

                        </tr>
                    </thead>
                    <tbody>
                        <% house.bids.forEach(bid=> { %>
                            <tr>
                                <td><a href="/house/<%= house._id %>/bid/<%= bid._id %>/delete" class="btn btn-danger">Delete</a></td>
                                <td>
                                    <%= bid.name %>
                                </td>
                                <td>$<%= bid.amount.toLocaleString() %>
                                </td>
                            </tr>



                    </tbody>
                    <% }); %>
                </table>

                <form action="/house/<%= house._id %>/add" method="post">
                    <div class="d-flex justify-content-between">
                      
                        <input type="text" name="bidderName" class="bidder-input form-control" placeholder="Bidder" required>
                        
                        
                        <input type="number" name="bidAmount" class="amount-input form-control" placeholder="0" min="1" required>
                
                      
                        <button type="submit" class="btn btn-primary">Add Bid</button>
                    </div>
                </form>
                
            </div>
        </div>
    </div>


</body>

</html>