<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Houses on the Market</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>


    <div class="row mb-4">
        <div class="col-sm-8 logo-text-container">
            <div>
                <img src="/images/logo.png" height="200" width="300">
            </div>
            <div>
                <h2 class="heading">Providing houses all over the world</h2>
            </div>
        </div>
    </div>

    <div>
        <h2 class="heading">Houses currently on the market</h2>
        <table class="table">

            <thead>

                <tr>
                    <th>Address</th>
                    <th>Country</th>
                    <th>Asking Price</th>
                    <th></th>

                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>12 Valley of Kings, Geneva</td>
                    <td>Switzerland</td>
                    <td style="color:red">$900,000</td>
                    <td><button class="btn btn-danger">Delete</button></td>
                </tr>
                <tr>
                    <td>89 Road of Forks, Bern</td>
                    <td>Switzerland</td>
                    <td style="color:red">$500,000</td>
                    <td><button class="btn btn-danger">Delete</button></td>
                </tr>
                <tr>
                    <td>Grote Hof 12, Amsterdam</td>
                    <td>The Netherlands</td>
                    <td>$200,500</td>
                    <td><button class="btn btn-danger">Delete</button></td>
                </tr>
                <tr>
                    <td>Meel Kade 321, The Hague</td>
                    <td>The Netherlands</td>
                    <td>$259,500</td>
                    <td><button class="btn btn-danger">Delete</button></td>
                </tr>
                <tr>
                    <td>Oude Gracht 32, Utrecht</td>
                    <td>The Netherlands</td>
                    <td>$400,500</td>
                    <td><button class="btn btn-danger">Delete</button></td>
                </tr>
            </tbody>

        </table>
    </div>

    <div class="d-flex justify-content-between">
        <button class="btn btn-primary">Add</button>
    </div>

</body>

</html>