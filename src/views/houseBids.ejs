<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>House Bids</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="container mt-5">

        <div class="row mb-4">
            <div class="col-sm-10 logo-text-container">
                <div>
                    <img src="/images/logo.png" height="200" width="300">
                </div>
                <div>
                    <h2 class="heading">Providing houses all over the world</h2>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="col-md-6">
                <img src="/images/house.jpg" class="property-img">
            </div>


            <div class="col-md-6">
                <div class="property-description">
                    <div>

                        <h4 style="font-weight: bold;">Switzerland</h4>
                        <h3 style="font-weight: bold;">12 Valley of Kings, Geneva</h3>

                        <p class="house-price">$900,000</p>
                        <p>A superb detached Victorian property on one of the town's finest roads, within easy reach of
                            Barnes Village. The property has in excess of 6000 sq/ft of accommodation, a driveway, and a
                            landscaped garden.</p>
                    </div>
                </div>


                <table class="table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Bidder</th>
                            <th>Amount</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><button class="btn btn-danger bid-btn">Delete</button></td>
                            <td>Sonia Reading</td>
                            <td>$200,000</td>
                        </tr>
                        <tr>
                            <td><button class="btn btn-danger bid-btn">Delete</button></td>
                            <td>Dick Johnson</td>
                            <td>$202,400</td>

                        </tr>
                        <tr>
                            <td><button class="btn btn-danger bid-btn">Delete</button></td>
                            <td>Roland</td>
                            <td>$203,000</td>

                        </tr>
                    </tbody>
                </table>


                <div class="d-flex justify-content-between">
                    <input type="text" class="bidder-input" placeholder="Bidder">
                    <input type="number" class="amount-input" placeholder="0">
                    <button class="btn btn-primary">Add</button>
                </div>
            </div>
        </div>
    </div>


</body>

</html>