<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Houses on the Market</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>


    <div class="row mb-4">
        <div class="col-sm-8 logo-text-container">
            <div>
                <img src="/images/logo.png" height="200" width="300">
            </div>
            <div>
                <h2 class="heading">Providing houses all over the world</h2>
            </div>
        </div>
    </div>
    
    <div>
        <h2 class="heading">Houses currently on the market</h2>
        
      
        <table class="table">

            <thead>

                <tr>
                    <th>Address</th>
                    <th>Country</th>
                    <th>Asking Price</th>
                    <th></th>

                </tr>
            </thead>

            <tbody>
                <% houses.forEach(house => { %>
                <tr>
                    <td><%=house.street%>, <%=house.city%></td>
                    <td><%=house.country%></td>
                    <td>$<%=house.askingPrice.toLocaleString()%></td>
                    <td><button class="btn btn-danger">Delete</button></td>
                </tr>
                 <% }); %>  
            </tbody>
         
            
        </table>
       
    </div>

    <div class="d-flex justify-content-between">
        <a href="/house/add" class="btn btn-primary">Add</a>
    </div>

</body>

</html>